# Admin remains unavailable unless this exact value is true.
ADMIN_ENABLED=false

# PostgreSQL is private and shared by application data and Better Auth.
DATABASE_URL=
DB_POOL_MAX=5

# Canonical admin origin and an exact comma-separated origin allowlist.
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=

# Google OAuth web client. Store both values only in the runtime secret store.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exactly two comma-separated identities: one Workspace and one personal.
# Their real addresses stay outside Git.
ADMIN_ALLOWED_EMAILS=
ADMIN_WORKSPACE_DOMAIN=
