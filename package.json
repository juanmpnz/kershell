{
  "name": "kershell-platform",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' --workspace-concurrency=1 run build",
    "build:admin": "pnpm --filter @kershell/admin build",
    "build:site": "pnpm --filter @kershell/site build",
    "dev": "pnpm --filter @kershell/site dev",
    "dev:admin": "pnpm --filter @kershell/admin dev",
    "dev:site": "pnpm --filter @kershell/site dev",
    "db:check": "./scripts/db-check.sh",
    "db:generate": "pnpm --filter @kershell/db generate",
    "db:seed": "pnpm --filter @kershell/db seed",
    "lint": "pnpm --filter './apps/*' --filter './packages/*' --if-present run lint",
    "start": "pnpm --filter @kershell/site start",
    "start:admin": "pnpm --filter @kershell/admin start",
    "start:site": "pnpm --filter @kershell/site start",
    "test": "pnpm --filter './apps/*' --filter './packages/*' --if-present run test",
    "typecheck": "pnpm --filter './apps/*' --filter './packages/*' --if-present run typecheck"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513"
}
